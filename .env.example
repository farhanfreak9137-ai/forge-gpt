# ForgeAgent V1 Environment Configuration Template

# Server Binding
FORGEAGENT_HOST=127.0.0.1
FORGEAGENT_PORT=8000
FORGEAGENT_DEBUG=false
FORGEAGENT_ENVIRONMENT=development

# Execution Mode (native | docker)
FORGEAGENT_EXECUTION_MODE=native
FORGEAGENT_COMMAND_TIMEOUT_SECONDS=60
FORGEAGENT_MAX_REPAIR_ATTEMPTS=4

# AI Reasoning Engine Defaults
FORGEAGENT_DEFAULT_AI_CONNECTOR=mock

# OpenAI-Compatible Connector Configuration
FORGEAGENT_OPENAI_BASE_URL=https://api.openai.com/v1
FORGEAGENT_OPENAI_API_KEY=
FORGEAGENT_OPENAI_MODEL_ID=gpt-4o

# Ollama Local Connector Configuration
FORGEAGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
FORGEAGENT_OLLAMA_MODEL_ID=llama3

